        Quantity AS quantity,
        Quantity * UnitPrice AS total
    FROM `airflow-tutorial-458409`.`retail`.`raw_invoices`
    WHERE Quantity > 0
)
SELECT
    invoice_id,
    dt.datetime_id,
    dp.product_id,
    dc.customer_id,
    quantity,
    total
FROM fct_invoices_cte fi
INNER JOIN `airflow-tutorial-458409`.`retail`.`dim_datetime` dt ON fi.datetime_id = dt.datetime_id
INNER JOIN `airflow-tutorial-458409`.`retail`.`dim_product` dp ON fi.product_id = dp.product_id
INNER JOIN `airflow-tutorial-458409`.`retail`.`dim_customer` dc ON fi.customer_id = dc.customer_id
    );
  
